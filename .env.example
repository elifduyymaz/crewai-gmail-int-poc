# Claude auth — an OAuth/seed token, NOT an API key.
# Obtain via `ant auth print-credentials --access-token` (or `claude setup-token`);
# handed to the Anthropic SDK as auth_token. This project does NOT use ANTHROPIC_API_KEY.
# (For a longer-lived, auto-refreshing setup, `ant auth login` stores an OAuth profile
#  the SDK reads automatically — then you can leave ANTHROPIC_AUTH_TOKEN blank.)
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=claude-sonnet-5

# Gmail OAuth (installed-app flow). Paths to gitignored credential files.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
