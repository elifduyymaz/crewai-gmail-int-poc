# Claude auth — a Claude Code seed token (OAuth), NOT an Anthropic Console
# API key. Obtain in a separate terminal:
#   claude setup-token
# The command opens a browser OAuth flow tied to your Claude subscription
# and prints an sk-ant-oat01-... value. Paste it to the right of the = below
# (no quotes). Handed to the Anthropic SDK as auth_token.
ANTHROPIC_AUTH_TOKEN=

# Anthropic model to use. Override to a heavier tier (e.g. claude-sonnet-4-6,
# claude-opus-4-7) if quota allows and the task demands more capability.
#
# Rate limits: the seed token draws from your Claude subscription quota,
# not a pay-per-token Console budget. Batch runs can exhaust the tier's
# 5-hour window (429 rate_limit_error). Smaller models (haiku) have
# separate quotas from sonnet/opus, so a rate-limit on one tier does not
# block another. Refresh the token via `claude setup-token` when it expires.
LLM_MODEL=claude-haiku-4-5-20251001

# Gmail OAuth (installed-app flow). Paths to gitignored credential files.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
